{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@domain/*": [
        "./src/domain/*"
      ],
      "@service/*": [
        "./src/service/*"
      ],
      "@feature/*": [
        "./src/feature/*"
      ],
      "@infra/*": [
        "./src/infra/*"
      ],
      "@style/*": [
        "./src/style/*"
      ],
      "@i18n/*": [
        "./src/i18n/*"
      ],
      "@prefs/*": [
        "./src/prefs/*"
      ],
      "@test/*": [
        "./test/*"
      ],
      "@scripts/*": [
        "./scripts/*"
      ],
      "@app/*": [
        "./src/app/*"
      ]
    }
  }
}
